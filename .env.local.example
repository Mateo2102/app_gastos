# ID de tu Google Sheet (lo sacás de la URL: docs.google.com/spreadsheets/d/ESTE_ID/edit)
SPREADSHEET_ID=1wY4YT3PdMK7hRJSO13Kk2XO4pGeLx95ZqZw1_zSqygA

# Credenciales de la Service Account de Google (ver README para cómo generarlas)
GOOGLE_SERVICE_ACCOUNT_EMAIL=nombre@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExxxx...\n-----END PRIVATE KEY-----\n"

# Opcional: si tu planilla NO usa la primera pestaña para los datos, poné su nombre exacto
SHEET_NAME=

# --- Acceso privado (inicio de sesión con Google, restringido a correos permitidos) ---
# En producción, si falta alguna de estas variables NADIE puede entrar (falla cerrado).
# En desarrollo, si no definís ninguna, la app queda abierta para trabajar en local.
# Un secreto largo y aleatorio (mínimo 32 caracteres). Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Credenciales OAuth de Google (tipo "Aplicación web"). Ver docs/AUTENTICACION.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Correos que pueden entrar, separados por coma
AUTH_ALLOWED_EMAILS=
# URL pública de la app (sin barra final). Recomendado en producción, ej.: https://app-gastos-olive.vercel.app
APP_URL=
